# dev | staging | production. Non-production environments are blocked from search engines (see src/app/robots.ts).
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# Set to 1 only after a solicitor has approved the legal pages. Until then they show a draft notice.
NEXT_PUBLIC_LEGAL_REVIEWED=
# Public address of the merchant portal. Leave empty to hide the "Sign in" link.
NEXT_PUBLIC_PORTAL_URL=
# Control-plane Postgres (Neon). Server-side only. Enquiries are stored here; without it the form reports a failure and offers email.
CONTROL_PLANE_DATABASE_URL=
