    "@vendure/core": "3.8.2",
    "@vendure/harden-plugin": "3.8.2",
    "@vendure/job-queue-plugin": "3.8.2",
    "bullmq": "^5.4.2",
    "ioredis": "^5.3.2",
    "pg": "^8.23.1",
    "stripe": "^23.1.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
