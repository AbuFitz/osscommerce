# One cell = one merchant. Every value is required unless marked optional; the process refuses to start on missing or unsafe settings.
APP_ENV=staging                 # development | staging | production
STORE_ID=store_xxx
CELL_ID=cell_xxx
CHANNEL_TOKEN=                  # 16+ random characters
DATABASE_URL=                   # Postgres. On Neon use the pooled connection string
REDIS_URL=                      # required in staging and production (job queue). rediss:// for TLS
SUPERADMIN_USER=                # platform operator, never given to a merchant
SUPERADMIN_PASSWORD=
COOKIE_SECRET=                  # 32+ random characters
STRIPE_SECRET_KEY=              # sk_test_ outside production, sk_live_ in production
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECTED_ACCOUNT_ID=    # the merchant's acct_
FEE_BP=50                       # 0.5% application fee
CONTROL_SECRET=                 # optional: lets the control plane pause checkout
PORT=3000
MODE=both                       # server | worker | both
# Only for `npm run setup` (first boot):
MERCHANT_EMAIL=
MERCHANT_PASSWORD=              # 12+ characters
